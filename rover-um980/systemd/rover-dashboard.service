[Unit]
Description=Rover UM980 mobile Web dashboard
After=network.target

[Service]
Type=simple
User=vtk
Group=vtk
WorkingDirectory=/home/vtk/Documents/rover-um980
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/vtk/Documents/rover-um980/.venv/bin/python /home/vtk/Documents/rover-um980/rover_dashboard.py --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=15
UMask=0027

[Install]
WantedBy=multi-user.target
